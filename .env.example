# Copy this file to .env and fill in your own key. Never commit or share .env.
# Get a key at: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=your-api-key-here

# Optional: model override.
# Default: glm-4.5-flash (FREE tier).
# Paid models (need balance): glm-5.3-flash, glm-4.6, glm-5.2 ...
# ZAI_MODEL=glm-5.3-flash

# Optional: thinking mode override (glm-5.x models require "enabled")
# ZAI_THINKING=enabled
